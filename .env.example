# ===================================================================
# 全球风能锂电人才搜索雷达 — 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# 注意：.env 已被 .gitignore 忽略，不会提交到 Git
# ===================================================================

# -------------------------------------------------------------------
# 数据库配置（支持 SQLite 开发 / PostgreSQL 生产）
# -------------------------------------------------------------------

# 开发环境（SQLite，无需安装数据库）
DATABASE_URL="file:./dev.db"

# 生产环境（PostgreSQL）
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public"
# 示例：
# DATABASE_URL="postgresql://postgres:password123@localhost:5432/global_talent_radar?schema=public"

# -------------------------------------------------------------------
# NextAuth / JWT 配置
# -------------------------------------------------------------------
NEXTAUTH_SECRET="please-change-this-to-a-secure-random-string"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="please-change-this-to-a-secure-random-string"

# -------------------------------------------------------------------
# 邮件发送配置（生产环境启用）
# -------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# EMAIL_FROM=noreply@globaltalentradar.com

# -------------------------------------------------------------------
# 文件上传配置
# -------------------------------------------------------------------
# UPLOAD_DIR=./public/uploads
# MAX_FILE_SIZE=5242880

# -------------------------------------------------------------------
# 国际化 / 时区默认
# -------------------------------------------------------------------
DEFAULT_LOCALE=zh
DEFAULT_TIMEZONE=Asia/Shanghai

# -------------------------------------------------------------------
# 演示模式（无真实数据库时启用 mock 数据兜底）
# -------------------------------------------------------------------
# DEMO_MODE=true

# ===================================================================
# AI 服务配置（所有 AI 功能均可在无 API Key 的情况下运行）
# ===================================================================

# AI 服务提供商：mock（默认，无需 Key）| openai（需要 OPENAI_API_KEY）
AI_PROVIDER=mock

# --- OpenAI 配置（仅 AI_PROVIDER=openai 时需要）---
# 注意：不要在此文件中填写真实 Key，Key 应设置在 .env 中（.env 已被 gitignore）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # 自定义端点（Azure / 代理），可选
# OPENAI_MODEL_NAME=gpt-4o-mini                 # 使用的模型名
# OPENAI_TEMPERATURE=0.3                          # 生成温度 0-2
# OPENAI_MAX_TOKENS=2048                           # 最大输出 token

# --- AI 通用配置 ---
# AI_TIMEOUT_MS=15000         # AI 请求超时毫秒
# AI_FALLBACK_MOCK=true      # 真实 AI 调用失败时是否 fallback 到 mock（推荐 true）

# ===================================================================
# 支付服务配置（当前使用 Mock，上线时替换为真实支付网关）
# ===================================================================

# 支付模式：mock（默认，无需任何 Key）| live（需要配置对应支付网关 Key）
PAYMENT_MODE=mock

# --- Stripe ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...

# --- Paddle ---
# PADDLE_API_KEY=...
# PADDLE_SELLER_ID=...
# PADDLE_WEBHOOK_SECRET=...

# --- 支付宝 ---
# ALIPAY_APP_ID=...
# ALIPAY_PRIVATE_KEY=...
# ALIPAY_PUBLIC_KEY=...
# ALIPAY_NOTIFY_URL=https://your-domain.com/api/payment/alipay/notify

# --- 微信支付 ---
# WECHAT_APP_ID=...
# WECHAT_MCH_ID=...
# WECHAT_API_KEY=...
# WECHAT_NOTIFY_URL=https://your-domain.com/api/payment/wechat/notify

# --- 发票（电子发票服务）---
# 实际上线时可接入：百望云 / 票通 / 用友电子发票
# INVOICE_API_KEY=...

